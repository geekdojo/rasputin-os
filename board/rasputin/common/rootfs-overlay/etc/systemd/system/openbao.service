# The node secrets store (ADR-0010; geekdojo/geekdojo-brain#755). The image's
# first sandboxed, non-root third-party daemon. Wanted on every image by a
# multi-user.target.wants link that post-build.sh makes (#756); there is no
# [Install] section, so Buildroot's preset-all leaves that link alone.
# rasputin-api.service also carries Wants=openbao.service (#757), so the api's
# start pulls the store in too. The conditions below skip it off the control
# plane, and on a control plane until the api mints the store CA and the
# server leaf.
# test/store-unit-test.sh asserts every line here;
# test/store-unit-functional.sh runs it under real systemd 258.7 with the real
# pinned bao.
[Unit]
Description=OpenBao secrets store
# The store's state and every credential source are on the persistent
# partition.
RequiresMountsFor=/var/lib/rasputin
# firstboot writes the role marker below. Ordering only: the condition is the
# gate, as on rasputin-api.service.
After=rasputin-firstboot.service
# The api's readiness wait is sys/health answering, not this ordering
# (ADR-0010 S6). The store has no ordering on the api, so the api may restart
# the store from inside its own start (#758) without a deadlock.
Before=rasputin-api.service
# Each start of the store pulls in its provisioner (#805), which adds the
# mounts and roles a later release lists once this run has unsealed. The
# provisioner is bound to this unit; this unit does not wait for it.
Wants=rasputin-store-provision.service
# Role gate: only a control plane runs the store.
ConditionPathExists=/var/lib/rasputin/role.controlplane
# First boot: the store CA and the server leaf do not exist until the api mints
# them (#758). Until then the store is skipped cleanly (inactive, not failed),
# which spends none of the start limit; #758 restarts the store once it has
# written the leaf. The seal key and the seal fragment have NO condition on
# purpose: a node with its CA and leaf but no seal material fails here, loudly,
# rather than skipping (S12).
ConditionPathExists=/var/lib/rasputin/trust/store-ca.pem
ConditionPathExists=/var/lib/rasputin/tls/openbao-server/leaf.pem
ConditionPathExists=/var/lib/rasputin/tls/openbao-server/leaf.key

[Service]
# OpenBao sends READY, RELOADING and STOPPING, and never pets a watchdog, so
# there is no watchdog setting here.
Type=notify
NotifyAccess=main
# S7: the static openbao user and group, 990:990 (package/openbao, OPENBAO_USERS).
User=openbao
Group=openbao
# The main config is baked into the image at /etc/rasputin/openbao/openbao.hcl
# (#756), and the self-init stanzas beside it in init.json (#804): on a store
# whose core is not initialised, bao creates the policies (their text from
# /usr/share/rasputin/openbao-policy/, which the api tarball ships), the kv-v2
# mount, cert auth and the api's, rotation job's and provisioner's roles,
# once, and keeps no root token. init.json is FROZEN from the store-arming
# release on (#805): a store runs it only on its first start, so a later
# release adds mounts and roles through provision.tsv and the provisioner,
# never here. The seal fragment arrives as a credential and is named by its
# literal path, because bao expands no variable in its config (#679 Q3).
ExecStart=/usr/bin/bao server -config=/etc/rasputin/openbao/openbao.hcl -config=/etc/rasputin/openbao/init.json -config=/run/credentials/openbao.service/seal.hcl
# The self-init outcome (#804): one console and journal line and the record
# /run/rasputin-store-init/outcome, which #833's reader turns into a job and an
# alert. pre notes a start that begins on an empty data directory; started
# (after READY, which on an empty store comes only after self-init) records
# initialised; stopped records failed if that start ended first. `+` runs the
# script as root outside this sandbox, because the record is root's; `-`
# means nothing it does fails the store: it reports, it does not gate.
ExecStartPre=-+/usr/lib/rasputin/store-init/rasputin-store-init.sh pre
ExecStartPost=-+/usr/lib/rasputin/store-init/rasputin-store-init.sh started
ExecStopPost=-+/usr/lib/rasputin/store-init/rasputin-store-init.sh stopped
# Everything root writes for the store reaches it here (#754): the store's uid
# can read none of these source directories, and only it and root can read the
# copies systemd makes under /run/credentials/openbao.service/.
LoadCredential=seal-key:/var/lib/rasputin/openbao-seal/seal-key
LoadCredential=seal.hcl:/var/lib/rasputin/openbao-seal/seal.hcl
LoadCredential=store-ca.pem:/var/lib/rasputin/trust/store-ca.pem
LoadCredential=server.pem:/var/lib/rasputin/tls/openbao-server/leaf.pem
LoadCredential=server.key:/var/lib/rasputin/tls/openbao-server/leaf.key
# The seal-key rotation's staged key (geekdojo/geekdojo-brain#830). A DIRECTORY
# source: systemd loads every file in it as seal-rotation_<file name>, and an
# empty directory loads nothing, so the key is optional without a second file
# source, which fails the unit at the CREDENTIALS step when the file is absent.
# The api writes rotation/<key id> and a seal fragment naming
# /run/credentials/openbao.service/seal-rotation_<key id>; tmpfiles makes the
# directory on every boot, and a missing directory fails the unit (fail closed).
LoadCredential=seal-rotation:/var/lib/rasputin/openbao-seal/rotation
# A process exit is a fact, so the store restarts on it. systemd's own restart
# delay and start limit apply (100 ms; 5 starts in 10 s): this unit chooses no
# duration (ARCH-FACTS). After a crash loop the unit sits in `failed`, nothing
# listens on 127.0.0.1, and F3.3's client raises the unreachable alert (#760).
# Recovery is by facts: whatever changes the cause (#758 on a new leaf, #766
# around a restore, #830 on a rotation) runs `systemctl reset-failed` and then
# `systemctl restart`. A reboot also resets the count.
Restart=always
# The filesystem is read-only to the store except its data and audit
# directories (#754).
ProtectSystem=strict
ReadWritePaths=/var/lib/rasputin/openbao /var/lib/rasputin/openbao-audit
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
# No capabilities at all: OpenBao removed mlock, and upstream's CAP_SYSLOG is
# unused.
CapabilityBoundingSet=
# Soft and hard. The manager's default is 0:infinity, which would let the
# process raise its own soft limit and dump the store's memory.
LimitCORE=0
# S2's reserve from F0.1. S6 (#684): the binary's file pages are charged to the
# store, and there is no MemoryHigh, because below the working set it stalls
# the store with no kill and no restart.
MemoryMax=128M
MemorySwapMax=0
# The lowest value the kernel still OOM-kills. -1000 would exempt the store
# from its own memory cgroup's kill and turn a clean OOM restart into a stall.
OOMScoreAdjust=-999
# 128 MiB minus 67.3 MiB, the largest file-backed resident set of a PebbleDB
# store in F0.1. The anonymous peak measured there is 27 MiB, so this never
# binds under measured load; it is GC back-pressure before the kernel kills.
Environment=GOMEMLIMIT=60MiB
# No journald rate-limit override: S11 audits to a file, and a per-unit
# LogRateLimitIntervalSec=0 is ignored anyway (#684).
