# One-time grow of the data partition to fill the disk, then reboot so the
# kernel re-reads the table and x-systemd.growfs expands the fs (see the script
# header). Idempotent — a no-op once grown.
#
# Ordering is load-bearing:
#   - After rasputin-mark-good.service: the GRUB boot-counter consumes one try
#     per boot, so the reboot this may trigger must happen only after the slot
#     is committed, or the next boot would roll back to the other slot. (On the
#     rpi mark-good is skipped, so this After is a no-op there — and growpart
#     only reboots at first boot, before any A/B trial; see the script header.)
#   - After var-lib-rasputin.mount: don't race makefs/growfs formatting the fs.
#   - After rasputin-firstboot.service: let provisioning finish first (it's
#     preserved across the grow, but no reason to interrupt it).
#   - After rasputin-api.service: the api is Type=notify and turns the
#     per-boot seal-key record (/run/rasputin-seal-key) into a job before it
#     sends READY=1 (geekdojo/geekdojo-brain#833), so the grow's reboot comes
#     after that and the provisioning boot's created outcome is not lost
#     (geekdojo/geekdojo-brain#853). Ordering only, no Wants=/Requires=: on a
#     compute node the api is condition-skipped and this changes nothing, and
#     a failed or timed-out api start does not block the grow. It makes direct
#     the edge that already ran through mark-good and the agent.
#
# Gate on the persistent MOUNT, not /dev/disk/by-partlabel/persistent: the rpi
# is MBR and addresses persistent by PARTUUID (no by-partlabel symlink), so the
# old gate skipped it. The mount exists for both arches when persistent is
# present; the script resolves the device from the mount.
[Unit]
Description=Rasputin: grow the data partition to fill the disk (one-time)
After=rasputin-mark-good.service var-lib-rasputin.mount rasputin-firstboot.service rasputin-api.service
ConditionPathIsMountPoint=/var/lib/rasputin

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/rasputin/growpart/rasputin-growpart.sh

[Install]
WantedBy=multi-user.target
