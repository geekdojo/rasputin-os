[Unit]
Description=Rasputin node agent
# Order after rasputin-api so the controlplane's co-located agent doesn't race
# the embedded NATS broker on a simultaneous (re)start — found 2026-06-13 during
# the bus-auth cutover: `systemctl restart rasputin-api rasputin-agent` started
# the agent before NATS was ready, so its first start failed (it self-healed via
# Restart=always). The api (Type=notify) also mints this agent's bus token file
# before it reports ready (geekdojo-brain#140), so the agent's first connect
# finds it; an agent that starts first anyway retries and joins once it exists.
# After= is ordering only and inert on non-controlplane nodes, where
# rasputin-api condition-skips (no role marker) and is never in the
# transaction.
After=network-online.target rasputin-firstboot.service rasputin-api.service
Wants=network-online.target
Requires=rasputin-firstboot.service
RequiresMountsFor=/var/lib/rasputin

[Service]
# Agent state (app compose files, updater/mesh backend state) must land on
# the persistent partition — the rootfs is read-only squashfs. The agent
# uses this value verbatim (no per-node suffix; one agent per host).
# node.env can still override it: EnvironmentFile beats Environment=.
Environment=RASPUTIN_AGENT_STATE_DIR=/var/lib/rasputin/agent-state
# How the controlplane's name guard repairs its own mDNS name. resolved probes
# for the hostname once at boot and, if another host on the LAN already claims
# it, backs off and NEVER re-probes — it neither renames nor reports, it just
# silently stops publishing for the rest of the uptime (bench 2026-07-28: the
# survivor couldn't resolve its own name even after the colliding host left,
# until resolved was restarted by hand). The agent detects that and runs this.
# Controlplane-only in effect — the guard doesn't start on other roles. Unset
# it in node.env to make the guard detect-and-report without acting.
#
# THE WHOLE ASSIGNMENT MUST BE QUOTED. systemd's Environment= splits on
# whitespace, so the unquoted form set this to just "systemctl" and silently
# discarded "restart systemd-resolved" as malformed assignments — the guard then
# ran `sh -c "systemctl"`, which prints usage and repairs nothing. Detection
# looked fine; recovery never once worked. Caught on the bench 2026-08-02, not
# by CI: nothing tests that a unit file's env reaches the process intact. Same
# trap the seed template already warns about for RASPUTIN_NTP_SERVER and the
# SSH key — an unquoted space breaks the value, in sh and in systemd alike.
Environment="RASPUTIN_MDNS_RECOVER_CMD=systemctl restart systemd-resolved"
# node.env is written by rasputin-firstboot onto the persistent partition.
EnvironmentFile=-/var/lib/rasputin/node.env
# Safety net for anything else that resolves paths relative to cwd (the
# env var above is the real fix for the agent's state dir).
WorkingDirectory=/var/lib/rasputin
ExecStart=/usr/bin/rasputin-agent
Restart=always
RestartSec=2
# systemd watchdog — part of the update defense-in-depth (the CM5
# bootloader can't count boot attempts, so userspace must catch a wedge).
# The agent pets via sd_notify(WATCHDOG=1) — implemented in control-plane
# v0.4.3 (agent/internal/sdnotify); BEFORE that the binary never notified
# and this stanza silently SIGABRT-killed the agent every 30s on every
# hardware boot since the scaffold (found 2026-06-12 on the Mu bench —
# every probe we had fit inside the ~28s live windows). Type=notify makes
# the contract explicit: a binary without notify support now fails START
# loudly instead of looping quietly. Do not pair WatchdogSec with a
# non-notifying binary again. See os-images/buildroot-os.md §3.
Type=notify
WatchdogSec=30
NotifyAccess=main
# The ONLY unit on the image that raises the core-dump limit, and the reason
# systemd-coredump is on the image at all: the intermittent rauc double-free
# abort (rasputin-os#8) must leave a backtrace the next time it happens.
#
# WHY HERE. systemd gives every service RLIMIT_CORE soft 0 unless told
# otherwise, and at soft 0 the kernel writes no core — coredump.conf's policy
# never even sees the crash. The rauc OTA path is `rauc install` run as a
# direct CHILD of this process (agent/internal/updater/rauc.go), and a child
# inherits the limit, so raising it on this unit covers the crash that #8 is
# about. rauc's D-Bus service mode is not built (BR2_PACKAGE_RAUC_DBUS is not
# set), so there is no separate rauc.service the abort could happen in.
#
# WHY NOT GLOBALLY. This was `[Manager] DefaultLimitCORE=infinity` in
# system.conf.d until 2026-09-19, which raised it for EVERY service. A core is
# a copy of a process's memory, so that made any crashing service able to write
# its secrets to the persistent partition. Scoped here, only the update path can
# — see etc/systemd/coredump.conf.d/rasputin.conf for where cores go and
# systemd-coredump@.service.d/rasputin-coredump.conf for their mode.
#
# The other two units that run rauc are deliberately NOT raised:
# rasputin-mark-good.service and rasputin-rauc-reconcile.service run
# `rauc status` / the Pi backend script, not an install, which is not the #8
# path. Raise one of those only if a crash is actually seen there.
#
# NOTE: a MANUAL `rauc install` from an interactive SSH shell is NOT covered
# (a shell's RLIMIT_CORE comes from PAM/limits, not systemd) — run it with
# `ulimit -c unlimited` if reproducing that way. That was already true of the
# global setting; the original #8 repro was manual, the real OTA path is
# service-driven and is covered.
LimitCORE=infinity

[Install]
WantedBy=multi-user.target
